@model IEnumerable<MoviesAdmin.Models.Review>

@{
    ViewData["Title"] = "Reviews";
}

<h1>My Reviews</h1>

<div class="card shadow">
    <div class="card-header bg-dark text-white">
        Review Database
    </div>

    <div class="card-body p-0"> 
            <div class="mb-3">
                <a asp-action="Index"
                   asp-route-sortOrder="date"
                   class="btn btn-pig-dark">
                    Sort by Release Date
                </a>

                <a asp-action="Index"
                   asp-route-sortOrder="title"
                   class="btn btn-truffle">
                    Sort by Title
                </a>
            </div><table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Movie</th>
                    <th>Rating</th>
                    <th>Published</th>
                    <th>Created</th>
                    <th>Manage</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Movie.Title</td>

                        <td>@item.Rating</td>

                        <td>
                            @* @(item.IsPublished ? "Yes" : "No") *@
                            @* If review is published, show pig head awake. If not, sleeping     *@
                            @if (item.IsPublished)
                                {
                                    <div class="review-status">
                                        <img src="~/images/pig-awake.png" alt="Published" class="status-pig" />
                                        <span>Published</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="review-status">
                                        <img src="~/images/pig-sleeping.png" alt="Draft" class="status-pig" />
                                        <span>Draft</span>
                                    </div>
                                }
                        </td>

                        <td>
                            @item.CreatedDate.ToString("MMM dd, yyyy")
                        </td>

                        <td class="review-actions">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-pig-dark btn-action">
                                Details
                            </a>

                            @if (!item.IsPublished)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-truffle btn-action">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-action">
                                    Delete
                                </a>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mt-3">

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index"
                   asp-route-page="@i"
                   asp-route-sortOrder="@ViewBag.CurrentSort"
                   class="btn btn-outline-secondary btn-sm">
                    @i
                </a>
            }

        </div>
    </div>
</div>
