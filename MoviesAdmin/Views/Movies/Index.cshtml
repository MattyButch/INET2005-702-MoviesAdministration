@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Movies Index</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-pig btn-lg shadow-sm">
            Add Movie
        </a>
    </p>
}

<div class="card shadow-lg">
    <div class="card-header bg-dark text-white">
        Movie Database
    </div>

    <div class="card-body">
        <table class="table table-hover table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>
                        Poster
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Description)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Length)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Rating)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ReleaseDate)
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail"/>
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Title)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Length)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Rating)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ReleaseDate)
                    </td>
                    <td> 
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-pig-dark btn-action">Details</a>
                        @if (User.IsInRole("Admin")){
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-truffle btn-action">Edit</a>
                        }
                        @if (User.IsInRole("Admin")){
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-action">Delete</a>
                        }
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>