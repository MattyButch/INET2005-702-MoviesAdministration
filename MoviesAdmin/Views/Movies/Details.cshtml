@using Microsoft.AspNetCore.Html
@model MoviesAdmin.Models.Movie

@{
    ViewData["Title"] = "Details";
}


<h1 class="mb-4">Movie Details - @Model.Title</h1>

<img src="@Model.ImageUrl" alt="@Model.Title" class="w-50" />


@* Note: Removed DL with TB to look more inline with index view *@
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            Movie Details
        </div>

        <table class="table mb-0">
            <tbody>
                <tr>
                    <th>Title</th>
                    <td>@Model.Title</td>
                </tr>

                <tr>
                    <th>Description</th>
                    <td>
                        @{
                            var descriptionWithBreaks = new HtmlString(Model.Description
                                .Replace("\r\n", "<br />")
                                .Replace("\n", "<br />")
                                .Replace("\r", "<br />"));
                        }

                        @descriptionWithBreaks
                    </td>
                </tr>
                <tr>
                    <th>Genre</th>
                    <td>@Model.Genre.GenreName</td>
                </tr>

                <tr>
                    <th>Length</th>
                    <td>@Model.Length</td>
                </tr>

                <tr>
                    <th>Rating</th>
                    <td>@Model.Rating</td>
                </tr>

                <tr>
                    <th>Release Date</th>
                    <td>@Model.ReleaseDate.ToString("MMM dd, yyyy")</td>
                </tr>
                <tr>
                    <th>Published Reviews</th>
                    <td>@Model.Reviews.Count(r => r.IsPublished)</td>
                </tr>
            </tbody>
        </table>
    </div>
<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-truffle">
            Edit Movie
        </a>
    }
    
    @*WRITE A REVIEW*@
        <a asp-controller="Reviews" asp-action="Create" asp-route-movieId="@Model.Id" class="btn btn-pig-dark">
            Write Review
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            Back to Movies
        </a>
</div>
